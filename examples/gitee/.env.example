# open-code-review Gitee service - example configuration.
#
# Copy to .env, fill in the blank values, and pass it to the container:
#   docker run --env-file .env ...
#
# A real environment variable always wins over this file, so `docker run -e`
# overrides whatever is written here.

# ---------------------------------------------------------------------------
# Gitee
# ---------------------------------------------------------------------------

# Leave the default unless you run Gitee Enterprise, where the API lives under
# the instance's own host.
GITEE_API_BASE=https://gitee.com/api/v5

# Personal access token used to post comments. It needs the pull request scope
# on every repository the service reviews. This is a write credential: treat it
# like a password.
GITEE_TOKEN=

# The signing key configured on the Gitee webhook. Set the webhook's
# "encryption type" to the signing-key option (encryption_type=1) rather than
# the password option, which embeds the secret in the URL and would land it in
# access logs.
GITEE_WEBHOOK_SECRET=

# The Gitee account name that git authenticates with over HTTPS. Gitee pairs
# this with the personal access token as the password. `oauth2` is the
# conventional placeholder and works on gitee.com; set your login name if your
# instance rejects it.
GITEE_GIT_USERNAME=oauth2

# ---------------------------------------------------------------------------
# Model credentials, forwarded to the ocr run
# ---------------------------------------------------------------------------

OCR_LLM_URL=
OCR_LLM_TOKEN=
OCR_LLM_MODEL=

# Empty means "let ocr decide", and ocr defaults to the Anthropic protocol.
# Set only if your gateway needs to be told explicitly.
OCR_USE_ANTHROPIC=
OCR_LLM_PROTOCOL=

# ---------------------------------------------------------------------------
# Service behaviour
# ---------------------------------------------------------------------------

# Address the service listens on. Keep it on an internal interface: the webhook
# endpoint authenticates requests, but nothing else about it is exposed on
# purpose.
GITEE_ADDR=:8080

# Where checkouts are written. Needs to be writable and to have room for one
# copy of the repository per review in flight.
GITEE_WORK_ROOT=/work

# Minutes handed to ocr's own --timeout. A review that is still running at this
# point stops and reports what it has.
GITEE_REVIEW_TIMEOUT_MIN=15

# How many reviews may run at once. Each one costs an LLM call per file group.
GITEE_CONCURRENCY=8

# Drop findings that a pinned dependency's published API contradicts. Works on
# npm packages today; see the README for what it can and cannot check.
GITEE_VERIFY_DEPS=true

# Log what would be posted instead of posting it. Leave this on for the first
# run against a real merge request, check the log, then set it to false.
GITEE_DRY_RUN=true
